{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "image": {
      "type": "object",
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string", "minLength": 1 },
        "digest": {
          "type": "string",
          "pattern": "^$|^sha256:[0-9a-f]{64}$"
        },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "effectiveVersion": {
      "type": "string",
      "pattern": "^$|^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "replicaCount": { "type": "integer", "minimum": 1 },
    "leaderElection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "leaseName": {
          "type": "string",
          "maxLength": 63,
          "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "leaseDurationSeconds": { "type": "integer", "minimum": 10, "maximum": 300 },
        "renewDeadlineSeconds": { "type": "integer", "minimum": 5, "maximum": 120 },
        "retryPeriodSeconds": { "type": "integer", "minimum": 1, "maximum": 30 }
      },
      "required": ["leaseName", "leaseDurationSeconds", "renewDeadlineSeconds", "retryPeriodSeconds"]
    },
    "controllerName": { "type": "string", "minLength": 1 },
    "managedConfigPath": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(/[A-Za-z0-9][A-Za-z0-9._-]*)+\\.toml$"
    },
    "watchNamespace": {
      "type": "string",
      "maxLength": 63,
      "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
    },
    "watchAllNamespaces": { "type": "boolean" },
    "statusService": { "type": "string" },
    "statusAddresses": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 253 }
    },
    "backendResolution": { "type": "string", "enum": ["cluster_dns", "endpoint_slice_watch"] },
    "dryRun": { "type": "boolean" },
    "filters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requestMirror", "externalAuth"],
      "properties": {
        "requestMirror": {
          "type": "object",
          "additionalProperties": false,
          "required": ["maxBodyBytes"],
          "properties": {
            "maxBodyBytes": { "type": "integer", "minimum": 0, "maximum": 16777216 }
          }
        },
        "externalAuth": {
          "type": "object",
          "additionalProperties": false,
          "required": ["maxBodyBytes", "allowedContentTypes", "allowedRequestHeaders", "allowedIdentityHeaders", "allowedTerminalHeaders", "allowCredentials"],
          "properties": {
            "maxBodyBytes": { "type": "integer", "minimum": 0, "maximum": 65535 },
            "allowedContentTypes": {
              "type": "array",
              "maxItems": 16,
              "uniqueItems": true,
              "items": { "type": "string", "pattern": "^[a-z0-9!#$&^_.+-]+/[a-z0-9!#$&^_.+-]+$" }
            },
            "allowedRequestHeaders": {
              "type": "array",
              "maxItems": 32,
              "uniqueItems": true,
              "items": { "type": "string", "pattern": "^[a-z0-9!#$%&'*+.^_`|~-]+$" }
            },
            "allowedIdentityHeaders": {
              "type": "array",
              "maxItems": 32,
              "uniqueItems": true,
              "items": { "type": "string", "pattern": "^[a-z0-9!#$%&'*+.^_`|~-]+$" }
            },
            "allowedTerminalHeaders": {
              "type": "array",
              "maxItems": 32,
              "uniqueItems": true,
              "items": { "type": "string", "pattern": "^[a-z0-9!#$%&'*+.^_`|~-]+$" }
            },
            "allowCredentials": { "type": "boolean" }
          }
        }
      }
    },
    "routePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxRequestBodyBytes", "maxTimeoutMs"],
      "properties": {
        "maxRequestBodyBytes": { "type": "integer", "minimum": 1, "maximum": 104857600 },
        "maxTimeoutMs": { "type": "integer", "minimum": 1, "maximum": 300000 }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "previousVersion", "deadline"],
      "properties": {
        "mode": { "type": "string", "enum": ["exact", "rolling_upgrade"] },
        "previousVersion": {
          "type": "string",
          "pattern": "^$|^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)([-+][0-9A-Za-z.-]+)?$"
        },
        "deadline": {
          "type": "string",
          "pattern": "^$|^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        }
      }
    },
    "l4": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bindAddress", "connectTimeoutMs", "idleTimeoutMs", "udp"],
      "properties": {
        "bindAddress": { "type": "string", "enum": ["0.0.0.0", "::"] },
        "connectTimeoutMs": { "type": "integer", "minimum": 1, "maximum": 60000 },
        "idleTimeoutMs": { "type": "integer", "minimum": 1000, "maximum": 3600000 },
        "udp": {
          "type": "object",
          "additionalProperties": false,
          "required": ["flowState", "maxFlows", "newFlowRate", "newFlowBurst", "datagramRate", "datagramBurst", "batch", "batchSize"],
          "properties": {
            "flowState": { "type": "string", "enum": ["disabled", "shared_required"] },
            "maxFlows": { "type": "integer", "minimum": 1, "maximum": 1048576 },
            "newFlowRate": { "type": "string", "pattern": "^[1-9][0-9]*(r/s|r/m)$" },
            "newFlowBurst": { "type": "integer", "minimum": 1, "maximum": 1048576 },
            "datagramRate": { "type": "string", "pattern": "^[1-9][0-9]*(r/s|r/m)$" },
            "datagramBurst": { "type": "integer", "minimum": 1, "maximum": 1048576 },
            "batch": { "type": "string", "enum": ["auto", "off", "required"] },
            "batchSize": { "type": "integer", "minimum": 1, "maximum": 1024 }
          }
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "automountServiceAccountToken": { "const": false },
        "tokenProjection": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "expirationSeconds": { "type": "integer", "minimum": 600, "maximum": 3600 }
          }
        }
      }
    },
    "rollout": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "targets": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "gatewayClassName", "allowedNamespaces", "workloadRef", "capabilities", "timeoutSeconds", "configMapPrefix"],
            "properties": {
              "name": { "type": "string", "minLength": 1, "maxLength": 63, "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$" },
              "gatewayClassName": { "type": "string", "minLength": 1, "maxLength": 253, "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$" },
              "allowedNamespaces": {
                "type": "array",
                "minItems": 1,
                "maxItems": 64,
                "uniqueItems": true,
                "items": { "type": "string", "minLength": 1, "maxLength": 63, "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$" }
              },
              "workloadRef": {
                "type": "object",
                "additionalProperties": false,
                "required": ["namespace", "kind", "name", "containerName", "volumeName"],
                "properties": {
                  "namespace": { "type": "string", "maxLength": 63, "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$" },
                  "kind": { "type": "string", "enum": ["Deployment", "DaemonSet"] },
                  "name": { "type": "string", "minLength": 1, "maxLength": 63, "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$" },
                  "containerName": { "type": "string", "minLength": 1, "maxLength": 63, "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$" },
                  "volumeName": { "type": "string", "minLength": 1, "maxLength": 63, "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$" }
                }
              },
              "capabilities": {
                "type": "array",
                "minItems": 1,
                "maxItems": 32,
                "uniqueItems": true,
                "items": { "type": "string", "minLength": 1, "maxLength": 63, "pattern": "^[a-z]([-a-z0-9]*[a-z0-9])?$" }
              },
              "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 3600 },
              "configMapPrefix": { "type": "string", "minLength": 1, "maxLength": 63, "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$" }
            }
          }
        },
        "target": {
          "type": "object",
          "properties": {
            "namespace": { "type": "string" },
            "kind": { "type": "string", "enum": ["deployment", "daemonset"] },
            "name": { "type": "string", "minLength": 1 },
            "containerName": { "type": "string", "minLength": 1 }
          },
          "required": ["kind", "name", "containerName"]
        },
        "volumeName": { "type": "string", "minLength": 1 },
        "timeoutSeconds": { "type": "integer", "minimum": 1 },
        "configMapPrefix": { "type": "string", "minLength": 1 }
      },
      "required": ["targets", "target", "volumeName", "timeoutSeconds", "configMapPrefix"]
    },
    "podAntiAffinity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "weight": { "type": "integer", "minimum": 1, "maximum": 100 },
        "topologyKey": { "type": "string", "minLength": 1 }
      },
      "required": ["enabled", "weight", "topologyKey"]
    },
    "topologySpreadConstraints": { "type": "array" },
    "podDisruptionBudget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "minAvailable": {
          "oneOf": [
            { "type": "integer", "minimum": 0 },
            { "type": "string", "pattern": "^[0-9]+%$" }
          ]
        }
      },
      "required": ["enabled", "minAvailable"]
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["watchAllNamespaces"],
        "properties": { "watchAllNamespaces": { "const": true } }
      },
      "then": {
        "properties": { "watchNamespace": { "const": "" } }
      }
    },
    {
      "if": {
        "required": ["compatibility"],
        "properties": {
          "compatibility": {
            "required": ["mode"],
            "properties": { "mode": { "const": "exact" } }
          }
        }
      },
      "then": {
        "properties": {
          "compatibility": {
            "properties": {
              "previousVersion": { "const": "" },
              "deadline": { "const": "" }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": ["compatibility"],
        "properties": {
          "compatibility": {
            "required": ["mode"],
            "properties": { "mode": { "const": "rolling_upgrade" } }
          }
        }
      },
      "then": {
        "properties": {
          "compatibility": {
            "required": ["previousVersion", "deadline"],
            "properties": {
              "previousVersion": { "type": "string", "minLength": 5 },
              "deadline": { "type": "string", "minLength": 20 }
            }
          }
        }
      }
    }
  ]
}
