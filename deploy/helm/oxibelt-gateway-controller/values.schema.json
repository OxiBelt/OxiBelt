{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "image": {
      "type": "object",
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string", "minLength": 1 },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "controllerName": { "type": "string", "minLength": 1 },
    "managedConfigPath": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(/[A-Za-z0-9][A-Za-z0-9._-]*)+\\.toml$"
    },
    "watchNamespace": {
      "type": "string",
      "maxLength": 63,
      "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
    },
    "watchAllNamespaces": { "type": "boolean" },
    "statusService": { "type": "string" },
    "backendResolution": { "type": "string", "enum": ["cluster_dns", "endpoint_slice_watch"] },
    "dryRun": { "type": "boolean" },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "automountServiceAccountToken": { "const": false },
        "tokenProjection": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "expirationSeconds": { "type": "integer", "minimum": 600, "maximum": 3600 }
          }
        }
      }
    },
    "rollout": {
      "type": "object",
      "properties": {
        "target": {
          "type": "object",
          "properties": {
            "namespace": { "type": "string" },
            "kind": { "type": "string", "enum": ["deployment", "daemonset"] },
            "name": { "type": "string", "minLength": 1 },
            "containerName": { "type": "string", "minLength": 1 }
          },
          "required": ["kind", "name", "containerName"]
        },
        "volumeName": { "type": "string", "minLength": 1 },
        "timeoutSeconds": { "type": "integer", "minimum": 1 },
        "configMapPrefix": { "type": "string", "minLength": 1 }
      },
      "required": ["target", "volumeName", "timeoutSeconds", "configMapPrefix"]
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["watchAllNamespaces"],
        "properties": { "watchAllNamespaces": { "const": true } }
      },
      "then": {
        "properties": { "watchNamespace": { "const": "" } }
      }
    }
  ]
}
