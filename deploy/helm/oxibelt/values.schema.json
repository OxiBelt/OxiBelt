{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "definitions": {
    "nonEmptyLabelSelector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["matchLabels"],
      "properties": {
        "matchLabels": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "string", "minLength": 1 }
        }
      }
    },
    "networkPolicyPeer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ipBlock": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cidr"],
          "properties": {
            "cidr": { "type": "string", "minLength": 1 },
            "except": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            }
          }
        },
        "namespaceSelector": { "$ref": "#/definitions/nonEmptyLabelSelector" },
        "podSelector": { "$ref": "#/definitions/nonEmptyLabelSelector" }
      },
      "oneOf": [
        {
          "required": ["ipBlock"],
          "not": {
            "anyOf": [
              { "required": ["namespaceSelector"] },
              { "required": ["podSelector"] }
            ]
          }
        },
        {
          "anyOf": [
            { "required": ["namespaceSelector"] },
            { "required": ["podSelector"] }
          ],
          "not": { "required": ["ipBlock"] }
        }
      ]
    },
    "networkPolicyPort": {
      "type": "object",
      "additionalProperties": false,
      "required": ["port", "protocol"],
      "properties": {
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "protocol": { "type": "string", "enum": ["TCP", "UDP"] },
        "endPort": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "networkPolicyDestination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "category", "to", "ports"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$",
          "maxLength": 63
        },
        "category": {
          "type": "string",
          "enum": ["upstream", "shared-state", "revocation", "kubernetes-api", "external-dependency"]
        },
        "to": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/networkPolicyPeer" }
        },
        "ports": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/networkPolicyPort" }
        }
      }
    },
    "ciliumNetworkPolicyPort": {
      "type": "object",
      "additionalProperties": false,
      "required": ["port", "protocol"],
      "properties": {
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "protocol": { "type": "string", "enum": ["TCP", "UDP"] }
      }
    },
    "ciliumFqdnDestination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "category", "matchNames", "ports"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$",
          "maxLength": 63
        },
        "category": {
          "type": "string",
          "enum": ["upstream", "shared-state", "revocation", "kubernetes-api", "external-dependency"]
        },
        "matchNames": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 3,
            "maxLength": 253,
            "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$"
          }
        },
        "ports": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/ciliumNetworkPolicyPort" }
        }
      }
    },
    "nonnegativeIntegerOrPercentage": {
      "oneOf": [
        { "type": "integer", "minimum": 0, "maximum": 999999999 },
        { "type": "string", "pattern": "^(0|[1-9][0-9]?|100)%$" }
      ]
    },
    "additionalServicePort": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "protocol", "port", "targetPort"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 15,
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "protocol": { "type": "string", "enum": ["TCP", "UDP"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "targetPort": { "type": "integer", "minimum": 1024, "maximum": 65535 }
      }
    }
  },
  "properties": {
    "operationalProfile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "enum": ["", "edge-secure-medium"]
        },
        "version": { "type": "integer", "minimum": 1 },
        "wafMode": { "type": "string", "enum": ["enforcing", "monitor"] }
      }
    },
    "image": {
      "type": "object",
      "properties": {
        "role": { "type": "string", "enum": ["dataplane", "dataplane-strict", "standalone"] },
        "repository": { "type": "string" },
        "tag": { "type": "string", "minLength": 1 },
        "digest": {
          "type": "string",
          "pattern": "^$|^sha256:[0-9a-f]{64}$"
        },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "workload": {
      "type": "object",
      "properties": {
        "kind": { "type": "string", "enum": ["Deployment", "DaemonSet"] },
        "deployment": {
          "type": "object",
          "properties": {
            "maxUnavailable": { "type": "integer", "minimum": 0 },
            "maxSurge": { "type": "integer", "minimum": 1 },
            "minReadySeconds": { "type": "integer", "minimum": 0 },
            "progressDeadlineSeconds": { "type": "integer", "minimum": 1 },
            "revisionHistoryLimit": { "type": "integer", "minimum": 0 }
          }
        },
        "daemonSet": {
          "type": "object",
          "properties": {
            "maxUnavailable": { "type": "integer", "minimum": 0, "maximum": 999999999 },
            "maxSurge": { "type": "integer", "minimum": 0, "maximum": 999999999 },
            "minReadySeconds": { "type": "integer", "minimum": 0 },
            "revisionHistoryLimit": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "replicaCount": { "type": "integer", "minimum": 1 },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "terminationGracePeriodSeconds": { "type": "integer", "minimum": 0, "maximum": 999999999 },
        "preStop": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "drainSeconds": { "type": "integer", "minimum": 1, "maximum": 86400 }
          }
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" },
        "automountServiceAccountToken": { "const": false }
      }
    },
    "service": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "annotations": { "type": "object", "additionalProperties": { "type": "string" } },
        "externalTrafficPolicy": { "type": "string", "enum": ["", "Cluster", "Local"] },
        "additionalPorts": {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "#/definitions/additionalServicePort" }
        }
      }
    },
    "kubernetesDiscovery": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "serviceAccountToken": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "expirationSeconds": { "type": "integer", "minimum": 600, "maximum": 3600 }
          }
        },
        "rbac": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "create": { "type": "boolean" },
            "namespaces": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 63,
                "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
              }
            }
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "ingress": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "public": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "allowAll": { "type": "boolean" },
                "from": {
                  "type": "array",
                  "items": { "$ref": "#/definitions/networkPolicyPeer" }
                }
              },
              "allOf": [
                {
                  "if": {
                    "required": ["allowAll"],
                    "properties": { "allowAll": { "const": true } }
                  },
                  "then": {
                    "properties": { "from": { "maxItems": 0 } }
                  }
                }
              ]
            },
            "metrics": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "from": {
                  "type": "array",
                  "items": { "$ref": "#/definitions/networkPolicyPeer" }
                }
              }
            },
            "admin": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "from": {
                  "type": "array",
                  "items": { "$ref": "#/definitions/networkPolicyPeer" }
                }
              }
            }
          }
        },
        "egress": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "dns": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": { "type": "boolean" },
                "to": {
                  "type": "array",
                  "items": { "$ref": "#/definitions/networkPolicyPeer" }
                }
              },
              "allOf": [
                {
                  "if": {
                    "required": ["enabled"],
                    "properties": { "enabled": { "const": true } }
                  },
                  "then": {
                    "required": ["to"],
                    "properties": { "to": { "minItems": 1 } }
                  }
                }
              ]
            },
            "destinations": {
              "type": "array",
              "items": { "$ref": "#/definitions/networkPolicyDestination" }
            }
          }
        },
        "cilium": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "dns": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "toEndpoints": {
                  "type": "array",
                  "items": { "$ref": "#/definitions/nonEmptyLabelSelector" }
                }
              }
            },
            "fqdnDestinations": {
              "type": "array",
              "items": { "$ref": "#/definitions/ciliumFqdnDestination" }
            }
          },
          "allOf": [
            {
              "if": {
                "required": ["enabled"],
                "properties": { "enabled": { "const": true } }
              },
              "then": {
                "required": ["dns", "fqdnDestinations"],
                "properties": {
                  "dns": {
                    "required": ["toEndpoints"],
                    "properties": { "toEndpoints": { "minItems": 1 } }
                  },
                  "fqdnDestinations": { "minItems": 1 }
                }
              }
            }
          ]
        }
      }
    },
    "admin": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "bindAddress": { "type": "string", "enum": ["127.0.0.1", "0.0.0.0", "::1", "::"] },
        "insecureDevelopmentMode": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" }
          }
        },
        "service": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "type": { "type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "annotations": { "type": "object" }
          }
        },
        "tokenSecretName": { "type": "string" },
        "tokenSecretKey": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
        "tls": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "secretName": { "type": "string" },
            "certKey": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
            "privateKeyKey": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
            "serverNames": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string" }
            }
          }
        },
        "mtls": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "enforcement": {
              "type": "string",
              "enum": ["required_non_loopback", "required_external", "optional"]
            },
            "clientCaSecretName": { "type": "string" },
            "clientCaSecretKey": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
            "verifyDepth": { "type": "integer", "minimum": 1, "maximum": 255 }
          }
        }
      }
    },
    "metrics": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" }
      }
    },
    "tls": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "secretName": { "type": "string" },
        "mountPath": { "type": "string", "minLength": 1 },
        "serverNames": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string" }
        }
      }
    },
    "quic": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hostKeySecretName": {
          "type": "string",
          "pattern": "^$|^[a-z0-9]([a-z0-9-]*[a-z0-9])?$",
          "maxLength": 253
        },
        "hostKeySecretKey": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+$"
        }
      }
    },
    "sharedState": {
      "type": "object",
      "properties": {
        "redisSecretProjections": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "secretName", "items"],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$",
                "maxLength": 63
              },
              "secretName": {
                "type": "string",
                "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$",
                "maxLength": 253
              },
              "items": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["key", "path"],
                  "properties": {
                    "key": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9._-]+$"
                    },
                    "path": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(/[A-Za-z0-9][A-Za-z0-9._-]*)*$"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "config": {
      "type": "object",
      "properties": {
        "create": { "type": "boolean" },
        "existingConfigMap": { "type": "string" },
        "existingConfigMapDigest": { "type": "string" },
        "key": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,252}$",
          "not": { "const": "gateway-config-directory" }
        },
        "mountPath": { "type": "string", "minLength": 1 },
        "inline": { "type": "string" }
      }
    },
    "configRollout": {
      "type": "object",
      "properties": {
        "mode": { "type": "string", "enum": ["helm_immutable", "kubernetes_immutable"] },
        "managedConfigPath": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(/[A-Za-z0-9][A-Za-z0-9._-]*)+\\.toml$"
        }
      }
    },
    "cacheVolume": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": { "type": "string", "enum": ["auto", "enabled", "disabled"] },
        "sizeLimit": { "type": "string" }
      }
    },
    "oxirule": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "existingConfigMap": { "type": "string" },
        "existingConfigMapDigest": { "type": "string" },
        "mountPath": { "type": "string", "minLength": 1 }
      }
    },
    "autoscaling": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "minReplicas": { "type": "integer", "minimum": 1 },
        "maxReplicas": { "type": "integer", "minimum": 1 },
        "targetCPUUtilizationPercentage": { "type": "integer", "minimum": 1, "maximum": 100 },
        "activeRequests": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "targetAverageValue": { "type": "integer", "minimum": 1 }
          }
        },
        "scaleDown": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "stabilizationWindowSeconds": { "type": "integer", "minimum": 0, "maximum": 3600 },
            "periodSeconds": { "type": "integer", "minimum": 1, "maximum": 1800 }
          }
        }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "minAvailable": {
          "anyOf": [
            { "$ref": "#/definitions/nonnegativeIntegerOrPercentage" },
            { "type": "null" }
          ]
        },
        "maxUnavailable": {
          "anyOf": [
            { "$ref": "#/definitions/nonnegativeIntegerOrPercentage" },
            { "type": "null" }
          ]
        },
        "unhealthyPodEvictionPolicy": {
          "type": "string",
          "enum": ["", "IfHealthyBudget", "AlwaysAllow"]
        }
      }
    },
    "podDistribution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "nodeSpread": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "maxSkew": { "type": "integer", "minimum": 1, "maximum": 999999999 },
            "minDomains": { "type": "integer", "minimum": 1, "maximum": 999999999 },
            "whenUnsatisfiable": {
              "type": "string",
              "enum": ["DoNotSchedule", "ScheduleAnyway"]
            }
          }
        },
        "zoneSpread": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "maxSkew": { "type": "integer", "minimum": 1, "maximum": 999999999 },
            "whenUnsatisfiable": {
              "type": "string",
              "enum": ["DoNotSchedule", "ScheduleAnyway"]
            }
          }
        },
        "podAntiAffinity": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "weight": { "type": "integer", "minimum": 1, "maximum": 100 }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["config"],
        "properties": {
          "config": {
            "required": ["existingConfigMap"],
            "properties": {
              "existingConfigMap": { "type": "string", "minLength": 1 }
            }
          }
        }
      },
      "then": {
        "properties": {
          "config": {
            "required": ["existingConfigMapDigest"],
            "properties": {
              "existingConfigMapDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": ["oxirule"],
        "properties": {
          "oxirule": {
            "required": ["enabled"],
            "properties": {
              "enabled": { "const": true }
            }
          }
        }
      },
      "then": {
        "properties": {
          "oxirule": {
            "required": ["existingConfigMap", "existingConfigMapDigest"],
            "properties": {
              "existingConfigMap": { "type": "string", "minLength": 1 },
              "existingConfigMapDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": ["admin"],
        "properties": {
          "admin": {
            "required": ["enabled"],
            "properties": {
              "enabled": { "const": true }
            }
          }
        }
      },
      "then": {
        "properties": {
          "admin": {
            "required": ["tokenSecretName"],
            "properties": {
              "tokenSecretName": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": ["admin"],
        "properties": {
          "admin": {
            "required": ["enabled", "tls"],
            "properties": {
              "enabled": { "const": true },
              "tls": {
                "required": ["enabled"],
                "properties": {
                  "enabled": { "const": true }
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "admin": {
            "properties": {
              "tls": {
                "required": ["secretName", "serverNames"],
                "properties": {
                  "secretName": { "type": "string", "minLength": 1 },
                  "serverNames": { "type": "array", "minItems": 1 }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": ["admin"],
        "properties": {
          "admin": {
            "required": ["enabled", "mtls"],
            "properties": {
              "enabled": { "const": true },
              "mtls": {
                "required": ["enabled"],
                "properties": {
                  "enabled": { "const": true }
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "admin": {
            "properties": {
              "mtls": {
                "required": ["clientCaSecretName"],
                "properties": {
                  "clientCaSecretName": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": ["config"],
        "properties": {
          "config": {
            "required": ["create"],
            "properties": {
              "create": { "const": false }
            }
          }
        }
      },
      "then": {
        "properties": {
          "config": {
            "required": ["existingConfigMap"],
            "properties": {
              "existingConfigMap": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": ["networkPolicy"],
        "properties": {
          "networkPolicy": {
            "required": ["cilium"],
            "properties": {
              "cilium": {
                "required": ["enabled"],
                "properties": { "enabled": { "const": true } }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "networkPolicy": {
            "required": ["enabled"],
            "properties": { "enabled": { "const": true } }
          }
        }
      }
    }
  ]
}
