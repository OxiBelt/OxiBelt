{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "image": {
      "type": "object",
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string", "minLength": 1 },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "workload": {
      "type": "object",
      "properties": {
        "kind": { "type": "string", "enum": ["Deployment", "DaemonSet"] },
        "deployment": {
          "type": "object",
          "properties": {
            "maxUnavailable": { "type": "integer", "minimum": 0 },
            "maxSurge": { "type": "integer", "minimum": 1 },
            "minReadySeconds": { "type": "integer", "minimum": 0 },
            "progressDeadlineSeconds": { "type": "integer", "minimum": 1 },
            "revisionHistoryLimit": { "type": "integer", "minimum": 0 }
          }
        },
        "daemonSet": {
          "type": "object",
          "properties": {
            "maxUnavailable": { "type": "integer", "minimum": 1 },
            "minReadySeconds": { "type": "integer", "minimum": 0 },
            "revisionHistoryLimit": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "replicaCount": { "type": "integer", "minimum": 1 },
    "service": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"] }
      }
    },
    "kubernetesDiscovery": {
      "type": "object",
      "properties": {
        "rbac": {
          "type": "object",
          "properties": {
            "create": { "type": "boolean" }
          }
        }
      }
    },
    "admin": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "bindAddress": { "type": "string", "enum": ["127.0.0.1", "0.0.0.0", "::1", "::"] },
        "insecureDevelopmentMode": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" }
          }
        },
        "service": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "type": { "type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "annotations": { "type": "object" }
          }
        },
        "tokenSecretName": { "type": "string" },
        "tokenSecretKey": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
        "tls": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "secretName": { "type": "string" },
            "certKey": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
            "privateKeyKey": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
            "serverNames": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string" }
            }
          }
        },
        "mtls": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "enforcement": {
              "type": "string",
              "enum": ["required_non_loopback", "required_external", "optional"]
            },
            "clientCaSecretName": { "type": "string" },
            "clientCaSecretKey": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
            "verifyDepth": { "type": "integer", "minimum": 1, "maximum": 255 }
          }
        }
      }
    },
    "metrics": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" }
      }
    },
    "tls": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "secretName": { "type": "string" },
        "mountPath": { "type": "string", "minLength": 1 }
      }
    },
    "config": {
      "type": "object",
      "properties": {
        "create": { "type": "boolean" },
        "existingConfigMap": { "type": "string" },
        "existingConfigMapDigest": { "type": "string" },
        "key": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,252}$",
          "not": { "const": "gateway-config-directory" }
        },
        "mountPath": { "type": "string", "minLength": 1 },
        "inline": { "type": "string" }
      }
    },
    "configRollout": {
      "type": "object",
      "properties": {
        "mode": { "type": "string", "enum": ["helm_immutable", "kubernetes_immutable"] },
        "managedConfigPath": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(/[A-Za-z0-9][A-Za-z0-9._-]*)+\\.toml$"
        }
      }
    },
    "oxirule": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "existingConfigMap": { "type": "string" },
        "existingConfigMapDigest": { "type": "string" },
        "mountPath": { "type": "string", "minLength": 1 }
      }
    },
    "autoscaling": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "minReplicas": { "type": "integer", "minimum": 1 },
        "maxReplicas": { "type": "integer", "minimum": 1 },
        "targetCPUUtilizationPercentage": { "type": "integer", "minimum": 1, "maximum": 100 }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "minAvailable": { "oneOf": [{ "type": "integer", "minimum": 0 }, { "type": "string" }] }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["config"],
        "properties": {
          "config": {
            "required": ["existingConfigMap"],
            "properties": {
              "existingConfigMap": { "type": "string", "minLength": 1 }
            }
          }
        }
      },
      "then": {
        "properties": {
          "config": {
            "required": ["existingConfigMapDigest"],
            "properties": {
              "existingConfigMapDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": ["oxirule"],
        "properties": {
          "oxirule": {
            "required": ["enabled"],
            "properties": {
              "enabled": { "const": true }
            }
          }
        }
      },
      "then": {
        "properties": {
          "oxirule": {
            "required": ["existingConfigMap", "existingConfigMapDigest"],
            "properties": {
              "existingConfigMap": { "type": "string", "minLength": 1 },
              "existingConfigMapDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": ["admin"],
        "properties": {
          "admin": {
            "required": ["enabled"],
            "properties": {
              "enabled": { "const": true }
            }
          }
        }
      },
      "then": {
        "properties": {
          "admin": {
            "required": ["tokenSecretName"],
            "properties": {
              "tokenSecretName": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": ["admin"],
        "properties": {
          "admin": {
            "required": ["enabled", "tls"],
            "properties": {
              "enabled": { "const": true },
              "tls": {
                "required": ["enabled"],
                "properties": {
                  "enabled": { "const": true }
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "admin": {
            "properties": {
              "tls": {
                "required": ["secretName", "serverNames"],
                "properties": {
                  "secretName": { "type": "string", "minLength": 1 },
                  "serverNames": { "type": "array", "minItems": 1 }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": ["admin"],
        "properties": {
          "admin": {
            "required": ["enabled", "mtls"],
            "properties": {
              "enabled": { "const": true },
              "mtls": {
                "required": ["enabled"],
                "properties": {
                  "enabled": { "const": true }
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "admin": {
            "properties": {
              "mtls": {
                "required": ["clientCaSecretName"],
                "properties": {
                  "clientCaSecretName": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": ["config"],
        "properties": {
          "config": {
            "required": ["create"],
            "properties": {
              "create": { "const": false }
            }
          }
        }
      },
      "then": {
        "properties": {
          "config": {
            "required": ["existingConfigMap"],
            "properties": {
              "existingConfigMap": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  ]
}
