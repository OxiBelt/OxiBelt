{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oxibelt.dev/schemas/kubernetes-feature-graduation-evidence-v2.json",
  "title": "OxiBelt detached Kubernetes feature graduation evidence receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "policyVersion",
    "policyDefinitionSha256",
    "featureId",
    "intendedStatus",
    "phase",
    "targetVersion",
    "repository",
    "sourceRef",
    "sourceRevision",
    "generatedAt",
    "qualifiedPlatforms",
    "workflow",
    "toolVersions",
    "artifactSubjects",
    "reportHashes",
    "logHashes",
    "gateResults",
    "result"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "policyVersion": { "type": "integer", "minimum": 1 },
    "policyDefinitionSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "featureId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "intendedStatus": { "const": "supported" },
    "phase": { "enum": ["candidate", "official_beta"] },
    "targetVersion": { "const": "0.8.0" },
    "repository": { "const": "OxiBelt/OxiBelt" },
    "sourceRef": {
      "type": "string",
      "pattern": "^refs/(heads|tags)/[A-Za-z0-9._/-]+$"
    },
    "sourceRevision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "generatedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "qualifiedPlatforms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["linux/amd64", "linux/arm64", "linux/riscv64"] }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "path", "ref", "runId", "runAttempt", "jobs"],
      "properties": {
        "repository": { "const": "OxiBelt/OxiBelt" },
        "path": { "const": ".github/workflows/feature-graduation.yml" },
        "ref": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "runId": { "type": "integer", "minimum": 1 },
        "runAttempt": { "type": "integer", "minimum": 1 },
        "jobs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "name", "conclusion"],
            "properties": {
              "id": { "type": "integer", "minimum": 1 },
              "name": { "type": "string", "minLength": 1 },
              "conclusion": { "const": "success" }
            }
          }
        }
      }
    },
    "toolVersions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version"],
        "properties": {
          "name": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$" },
          "version": { "type": "string", "minLength": 1 }
        }
      }
    },
    "artifactSubjects": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "kind", "reference", "digest"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$" },
          "kind": { "enum": ["oci-image", "helm-chart"] },
          "reference": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+-]*$" },
          "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
        }
      }
    },
    "reportHashes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "sha256"],
        "properties": {
          "name": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "logHashes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["jobId", "sha256"],
        "properties": {
          "jobId": { "type": "integer", "minimum": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "gateResults": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "platformResults"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "platformResults": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["platform", "jobId", "reportName", "reportSha256", "result"],
              "properties": {
                "platform": { "enum": ["linux/amd64", "linux/arm64", "linux/riscv64"] },
                "jobId": { "type": "integer", "minimum": 1 },
                "reportName": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$" },
                "reportSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
                "result": { "const": "pass" }
              }
            }
          }
        }
      }
    },
    "result": { "const": "pass" }
  }
}
