{
  "$schema": "./kubernetes-feature-graduation.schema.json",
  "schemaVersion": 2,
  "policyVersion": 4,
  "lifecycleAuthority": "docs/FeatureStatus.md",
  "evidenceSchema": "devops/config/kubernetes-feature-graduation-evidence.schema.json",
  "supportContract": {
    "kubernetes": {
      "range": ">=1.34.0-0 <1.37.0-0",
      "minors": [
        {
          "minor": "1.34",
          "ciVersion": "v1.34.8",
          "kindNodeImage": "kindest/node:v1.34.8@sha256:02722c2dedddcfc00febf5d27fbeb9b7b2c14294c82109ff4a85d89ac9ba3256"
        },
        {
          "minor": "1.35",
          "ciVersion": "v1.35.5",
          "kindNodeImage": "kindest/node:v1.35.5@sha256:ce977ae6d65918d0b58a5f8b5e940429c2ce42fa3a5619ec2bbc60b949c0ac95"
        },
        {
          "minor": "1.36",
          "ciVersion": "v1.36.1",
          "kindNodeImage": "kindest/node:v1.36.1@sha256:3489c7674813ba5d8b1a9977baea8a6e553784dab7b84759d1014dbd78f7ebd5"
        }
      ]
    },
    "helm": {
      "versions": [
        "3.21.3",
        "4.2.4"
      ],
      "upgradeCompatibility": "clean-install-upgrade-rollback-uninstall"
    },
    "gatewayApi": {
      "version": "v1.6.1",
      "channel": "standard",
      "servedVersion": "v1",
      "standardInstallUrl": "https://github.com/kubernetes-sigs/gateway-api/releases/download/v1.6.1/standard-install.yaml",
      "standardInstallSha256": "24d931f22abd8e40c973264319ead7cfa09d0fb7716b7ab1ee2ff174cb063a73"
    },
    "crdLifecycle": {
      "owner": "operator",
      "chartInstalls": false,
      "chartConverts": false,
      "chartDeletes": false,
      "supportedUpgradeOrder": [
        "apply and establish the pinned standard CRD bundle",
        "upgrade the Gateway controller",
        "upgrade the selected data-plane workload"
      ]
    },
    "controllerDataPlaneSkew": {
      "defaultMode": "exact",
      "rollingMode": "rolling_upgrade",
      "maximumRollingHours": 24,
      "upgradeOrder": [
        "set rolling_upgrade with an explicit version from the immediately preceding minor and a deadline",
        "upgrade the controller before the data plane",
        "restore exact mode after convergence"
      ],
      "rollbackOrder": [
        "keep rolling_upgrade active while both permitted versions exist",
        "roll back the data plane before the controller",
        "restore exact mode after convergence"
      ]
    },
    "architectures": [
      {
        "name": "linux/amd64",
        "nativeClusterRequired": true,
        "qualification": "pending"
      },
      {
        "name": "linux/arm64",
        "nativeClusterRequired": true,
        "qualification": "pending"
      },
      {
        "name": "linux/riscv64",
        "nativeClusterRequired": true,
        "qualification": "blocked"
      }
    ],
    "networking": {
      "ipFamilies": [
        "IPv4"
      ],
      "networkPolicyCnis": [
        "Calico",
        "Cilium"
      ]
    },
    "podSecurity": {
      "standard": "restricted",
      "mode": "enforce",
      "version": "latest"
    }
  },
  "cadences": [
    {
      "id": "pull_request",
      "purpose": "Validate the policy, documentation, charts, Kubernetes floor end-to-end path, ceiling smoke path, and fail-closed diagnostics."
    },
    {
      "id": "nightly",
      "purpose": "Exercise every Kubernetes minor and Helm line, both NetworkPolicy CNIs, fault recovery, propagation, rotation, and a bounded one-hour soak."
    },
    {
      "id": "release_candidate",
      "purpose": "Produce exact-revision promotion evidence for every mandatory gate, architecture, conformance profile, previous-minor path, and eight-hour soak."
    },
    {
      "id": "stable",
      "purpose": "Verify and consume the exact release-candidate evidence without rebuilding or accepting mutable references."
    }
  ],
  "blockers": [
    {
      "id": "previous-stable-role-topology",
      "reason": "No eligible previous stable release currently provides the complete controller and data-plane role topology required for released-artifact upgrade and rollback evidence."
    },
    {
      "id": "native-riscv64-cluster-runner",
      "reason": "No native RISC-V Kubernetes worker is available; QEMU user-mode image smoke is not Kubernetes qualification evidence."
    }
  ],
  "gates": [
    {
      "id": "policy-contract",
      "objective": "The registry, generated support tables, feature lifecycle matrix, release contract, charts, and workflow topology agree.",
      "cadence": "pull_request",
      "mandatory": true,
      "appliesTo": [
        "gateway-controller",
        "gateway-api-httproute",
        "gateway-api-grpcroute",
        "gateway-api-tlsroute",
        "gateway-api-tcproute",
        "gateway-api-udproute",
        "gateway-api-backendtlspolicy",
        "gateway-api-weighted-discovery",
        "gateway-api-standard-filters-backend-tls",
        "gateway-api-route-policy",
        "gateway-controller-multi-target",
        "gateway-controller-explain",
        "supply-chain-admission-bundle",
        "helm-data-plane",
        "helm-gateway-controller"
      ]
    },
    {
      "id": "unsupported-combination-diagnostics",
      "objective": "Helm, controller readiness, support metadata, and operator diagnostics reject or clearly identify every unsupported Kubernetes, Gateway API, architecture, and skew combination.",
      "cadence": "pull_request",
      "mandatory": true,
      "appliesTo": [
        "gateway-controller",
        "gateway-api-httproute",
        "gateway-api-grpcroute",
        "gateway-api-tlsroute",
        "gateway-api-tcproute",
        "gateway-api-udproute",
        "gateway-api-backendtlspolicy",
        "gateway-api-weighted-discovery",
        "gateway-api-standard-filters-backend-tls",
        "gateway-api-route-policy",
        "gateway-controller-multi-target",
        "gateway-controller-explain",
        "supply-chain-admission-bundle",
        "helm-data-plane",
        "helm-gateway-controller"
      ]
    },
    {
      "id": "clean-lifecycle",
      "objective": "Clean install, same-version upgrade, rollback, and uninstall converge while operator-owned Gateway API CRDs and retained immutable rollback objects follow the documented ownership contract.",
      "cadence": "release_candidate",
      "mandatory": true,
      "appliesTo": [
        "gateway-controller",
        "gateway-controller-multi-target",
        "helm-data-plane",
        "helm-gateway-controller"
      ]
    },
    {
      "id": "leader-election-failover",
      "objective": "Leader deletion, follower takeover, Lease deletion and recreation, and stale-writer fencing preserve a single active writer with takeover within 45 seconds.",
      "cadence": "nightly",
      "mandatory": true,
      "appliesTo": [
        "gateway-controller",
        "gateway-controller-multi-target",
        "helm-gateway-controller"
      ]
    },
    {
      "id": "api-outage-recovery",
      "objective": "A bounded Kubernetes API outage and leader-only API partition produce no unproved writes and recover reconciliation within 90 seconds after connectivity returns.",
      "cadence": "nightly",
      "mandatory": true,
      "appliesTo": [
        "gateway-controller",
        "gateway-controller-multi-target",
        "helm-gateway-controller"
      ]
    },
    {
      "id": "watch-reconnect-compaction",
      "objective": "Watch close, timeout, error events, and HTTP 410 resource-version compaction trigger a fresh list or GET without stale authority.",
      "cadence": "pull_request",
      "mandatory": true,
      "appliesTo": [
        "gateway-controller",
        "gateway-api-weighted-discovery",
        "gateway-api-route-policy",
        "gateway-controller-multi-target"
      ]
    },
    {
      "id": "stale-object-convergence",
      "objective": "Accepted, rejected, deleted, and corrected Gateway API objects converge to fresh status and configuration without preserving stale authority.",
      "cadence": "nightly",
      "mandatory": true,
      "appliesTo": [
        "gateway-controller",
        "gateway-api-httproute",
        "gateway-api-grpcroute",
        "gateway-api-tlsroute",
        "gateway-api-tcproute",
        "gateway-api-udproute",
        "gateway-api-backendtlspolicy",
        "gateway-api-weighted-discovery",
        "gateway-api-standard-filters-backend-tls",
        "gateway-api-route-policy",
        "gateway-controller-multi-target",
        "gateway-controller-explain"
      ]
    },
    {
      "id": "partial-rollout-recovery",
      "objective": "A stalled, rejected, or partially Ready candidate never commits and restores the last committed revision before a distinct candidate may proceed.",
      "cadence": "pull_request",
      "mandatory": true,
      "appliesTo": [
        "gateway-controller",
        "gateway-controller-multi-target",
        "gateway-controller-explain",
        "helm-data-plane",
        "helm-gateway-controller"
      ]
    },
    {
      "id": "network-partition",
      "objective": "Controller-to-API and multi-node partitions preserve fencing, readiness, and last-committed configuration guarantees and recover within the documented bounds.",
      "cadence": "nightly",
      "mandatory": true,
      "appliesTo": [
        "gateway-controller",
        "gateway-controller-multi-target",
        "helm-data-plane",
        "helm-gateway-controller"
      ]
    },
    {
      "id": "configmap-propagation",
      "objective": "Base configuration, generated configuration, and BackendTLSPolicy public-CA ConfigMap changes create and converge the expected immutable revision within 300 seconds.",
      "cadence": "nightly",
      "mandatory": true,
      "appliesTo": [
        "gateway-controller",
        "gateway-api-backendtlspolicy",
        "gateway-api-standard-filters-backend-tls",
        "gateway-controller-multi-target",
        "helm-data-plane",
        "helm-gateway-controller"
      ]
    },
    {
      "id": "secret-rotation",
      "objective": "Versioned TLS and Admin Secret replacement followed by a Helm rollout activates only the intended Secret without claiming unsupported in-place hot reload.",
      "cadence": "nightly",
      "mandatory": true,
      "appliesTo": [
        "helm-data-plane"
      ]
    },
    {
      "id": "multi-node",
      "objective": "A multi-node cluster preserves topology, disruption, rollout, status, and traffic behavior through one worker loss.",
      "cadence": "nightly",
      "mandatory": true,
      "appliesTo": [
        "gateway-controller",
        "gateway-controller-multi-target",
        "helm-data-plane",
        "helm-gateway-controller"
      ]
    },
    {
      "id": "pod-security-restricted",
      "objective": "Both charts install and operate in a namespace enforcing the Kubernetes restricted Pod Security Standard.",
      "cadence": "pull_request",
      "mandatory": true,
      "appliesTo": [
        "helm-data-plane",
        "helm-gateway-controller"
      ]
    },
    {
      "id": "live-supply-chain-admission",
      "objective": "The complete edge-secure-medium v2 chart runs on exactly three Ready nodes with build-validated exact images and renders webhook ingress restricted to exact API-server host prefixes while the live TLS webhook admits every authorized executable class, rejects mismatched identities, fails closed on TLS and endpoint outages without intercepting unrelated resources, and rotates TLS and signed bundles with overlap and rollback.",
      "cadence": "pull_request",
      "mandatory": true,
      "appliesTo": [
        "supply-chain-admission-bundle",
        "helm-data-plane"
      ]
    },
    {
      "id": "network-policy-cnis",
      "objective": "The portable NetworkPolicy contract passes on both Calico and Cilium in IPv4 single-stack clusters without undeclared egress.",
      "cadence": "nightly",
      "mandatory": true,
      "appliesTo": [
        "helm-data-plane",
        "helm-gateway-controller"
      ]
    },
    {
      "id": "previous-minor-interop",
      "objective": "Release-candidate and immediately preceding minor released or release-equivalent artifacts pass bounded rolling upgrade and rollback using immutable verified digests.",
      "cadence": "release_candidate",
      "mandatory": true,
      "appliesTo": [
        "gateway-controller",
        "gateway-controller-multi-target",
        "helm-data-plane",
        "helm-gateway-controller"
      ]
    },
    {
      "id": "long-duration-soak",
      "objective": "An eight-hour correctness soak repeats route changes, traffic, leader replacement, and API disruptions with no stale writes, digest mismatch, or unrecovered readiness loss.",
      "cadence": "release_candidate",
      "mandatory": true,
      "appliesTo": [
