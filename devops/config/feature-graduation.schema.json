{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oxibelt.dev/schemas/feature-graduation-v1.json",
  "title": "OxiBelt non-Kubernetes feature graduation policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "policyVersion",
    "lifecycleAuthority",
    "evidenceSchema",
    "repository",
    "targetVersion",
    "gates",
    "features"
  ],
  "properties": {
    "$schema": { "const": "./feature-graduation.schema.json" },
    "schemaVersion": { "const": 1 },
    "policyVersion": { "type": "integer", "minimum": 1 },
    "lifecycleAuthority": { "const": "docs/FeatureStatus.md" },
    "evidenceSchema": {
      "const": "devops/config/feature-graduation-evidence.schema.json"
    },
    "repository": { "const": "OxiBelt/OxiBelt" },
    "targetVersion": {
      "type": "string",
      "const": "0.8.0"
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "objective", "appliesTo"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "objective": { "type": "string", "minLength": 1 },
          "appliesTo": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            }
          }
        }
      }
    },
    "features": {
      "type": "array",
      "minItems": 10,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "lastValidatedVersion",
          "qualifiedPlatforms",
          "dependsOn",
          "gateIds"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "status": { "enum": ["experimental", "supported"] },
          "lastValidatedVersion": {
            "type": "string",
            "pattern": "^(unvalidated|[0-9]+\\.[0-9]+\\.[0-9]+)$"
          },
          "qualifiedPlatforms": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "enum": ["linux/amd64", "linux/arm64"] }
          },
          "dependsOn": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            }
          },
          "gateIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            }
          }
        }
      }
    }
  }
}
