{
  "name": "oxibelt",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0+sha512.cca3cea332ad254bb84145f966d19f4879615210346fc92c79a047f23a0d7b3cca3c3792f0076ba1f1831d277efbcf0a9119b31a9a60eca7fb3d6231f331ef72",
  "workspaces": [
    "devops",
    "ui/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc -p tsconfig.json --noEmit && npm run typecheck --workspaces --if-present",
    "lint": "eslint \"devops/**/*.ts\" \"ui/*/source/**/*.ts\"",
    "test": "node --import tsx --test devops/tests/*.test.ts",
    "dependency-admission": "node --import tsx devops/sources/dependency_admission.ts --workspace-path . --policy-path supply-chain/dependency-policy.json",
    "image-vulnerability-policy:check": "node --import tsx devops/sources/image_vulnerability_policy.ts validate-policy --policy supply-chain/image-vulnerability-policy.json",
    "kubernetes-graduation:check": "node --import tsx devops/sources/kubernetes_graduation.ts check --workspace-path .",
    "kubernetes-graduation:render": "node --import tsx devops/sources/kubernetes_graduation.ts render --workspace-path .",
    "release-contract:check": "node --import tsx devops/sources/release_contract.ts check --workspace-path .",
    "release-contract:candidate": "node --import tsx devops/sources/release_contract.ts candidate --workspace-path .",
    "release-contract:verify": "node --import tsx devops/sources/release_contract.ts verify-release",
    "versioning:check": "node --import tsx devops/sources/versioning.ts --workspace-path . --manifest-path Cargo.toml --package-name oxibelt --lockfile-path Cargo.lock",
    "versioning:release": "node --import tsx devops/sources/versioning.ts --workspace-path . --manifest-path Cargo.toml --package-name oxibelt --lockfile-path Cargo.lock --ref \"$OXIBELT_RELEASE_REF\" --revision \"$OXIBELT_RELEASE_REVISION\" --event-name \"$GITHUB_EVENT_NAME\" --release-prerelease \"$OXIBELT_RELEASE_IS_PRERELEASE\" --image-plan-output \"$OXIBELT_IMAGE_PLAN_OUTPUT\" --release-publish",
    "person-proof-ui:build": "npm run build --workspace @oxibelt/person-proof-ui"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/semver": "7.7.1",
    "@typescript-eslint/eslint-plugin": "8.65.0",
    "@typescript-eslint/parser": "8.65.0",
    "eslint": "10.7.0",
    "tsx": "4.23.1",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "semver": "7.8.5",
    "smol-toml": "1.7.0"
  }
}
