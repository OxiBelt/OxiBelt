ARG RUST_BUILDER_IMAGE=rust:1.96.0-trixie
ARG OXIBELT_NODE_IMAGE=node:24-alpine3.24
ARG OXIBELT_RUNTIME_IMAGE=alpine:3.24
ARG OXIBELT_VERSION=0.0.0
ARG OXIBELT_REVISION=unknown
ARG OXIBELT_CREATED=1970-01-01T00:00:00Z
ARG OXIBELT_SOURCE=https://github.com/OxiBelt/OxiBelt
ARG OXIBELT_REF_NAME=0.0.0

FROM --platform=$BUILDPLATFORM ${OXIBELT_NODE_IMAGE} AS person-proof-ui

WORKDIR /repo
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.json ./
COPY devops/package.json ./devops/package.json
COPY ui/person-proof/package.json ./ui/person-proof/package.json
RUN corepack enable && \
    corepack prepare pnpm@11.13.0 --activate && \
    pnpm install --frozen-lockfile --ignore-scripts --filter @oxibelt/person-proof-ui...
COPY ui/person-proof ./ui/person-proof
RUN --network=none pnpm --filter @oxibelt/person-proof-ui build

FROM ${RUST_BUILDER_IMAGE} AS builder

ARG TARGETARCH
ARG OXIBELT_RUST_TARGET=
ARG OXIBELT_RUST_TARGET_CPU=
ARG OXIBELT_REVISION

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      build-essential \
      clang \
      cmake \
      libclang-dev \
      musl-tools \
      ninja-build \
      perl \
      pkg-config && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /repo
COPY Cargo.toml Cargo.lock ./
COPY source ./source
COPY source/apps/oxibelt-gateway-controller ./source/apps/oxibelt-gateway-controller
COPY source/apps/oxibelt-keysigner ./source/apps/oxibelt-keysigner
COPY source/apps/oxibelt-netport-switcher ./source/apps/oxibelt-netport-switcher
COPY source/apps/oxibeltctl ./source/apps/oxibeltctl
COPY source/crates/oxibelt-control-http ./source/crates/oxibelt-control-http
COPY source/crates/oxibelt-control-protocol ./source/crates/oxibelt-control-protocol
COPY source/crates/oxibelt-deployment-diagnostics ./source/crates/oxibelt-deployment-diagnostics
COPY fuzz ./fuzz
COPY tests/unsafe_harness ./tests/unsafe_harness

ENV OXIBELT_SOURCE_REVISION=${OXIBELT_REVISION}

RUN rust_target="${OXIBELT_RUST_TARGET}" && \
    if [ -z "${rust_target}" ]; then \
      case "${TARGETARCH}" in \
        amd64) rust_target=x86_64-unknown-linux-musl ;; \
        arm64) rust_target=aarch64-unknown-linux-musl ;; \
        riscv64) rust_target=riscv64gc-unknown-linux-musl ;; \
        *) echo "unsupported TARGETARCH=${TARGETARCH}" >&2; exit 1 ;; \
      esac; \
    fi && \
    case "${rust_target}" in \
      x86_64-unknown-linux-musl) \
        case "${OXIBELT_RUST_TARGET_CPU}" in \
          ""|x86-64-v2|x86-64-v3|x86-64-v4) ;; \
          *) echo "unsupported OXIBELT_RUST_TARGET_CPU=${OXIBELT_RUST_TARGET_CPU}" >&2; exit 1 ;; \
        esac; \
        export CC_x86_64_unknown_linux_musl=musl-gcc; \
        export CARGO_TARGET_X86_64_UNKNOWN_LINUX_MUSL_LINKER=musl-gcc; \
        if [ -n "${OXIBELT_RUST_TARGET_CPU}" ]; then \
          export CARGO_TARGET_X86_64_UNKNOWN_LINUX_MUSL_RUSTFLAGS="-Ctarget-cpu=${OXIBELT_RUST_TARGET_CPU}"; \
        fi \
        ;; \
      aarch64-unknown-linux-musl) \
        if [ -n "${OXIBELT_RUST_TARGET_CPU}" ]; then \
          echo "OXIBELT_RUST_TARGET_CPU is only supported with x86_64-unknown-linux-musl" >&2; \
          exit 1; \
        fi; \
        export CC_aarch64_unknown_linux_musl=musl-gcc; \
        export CARGO_TARGET_AARCH64_UNKNOWN_LINUX_MUSL_LINKER=musl-gcc \
        ;; \
      riscv64gc-unknown-linux-musl) \
        if [ -n "${OXIBELT_RUST_TARGET_CPU}" ]; then \
          echo "OXIBELT_RUST_TARGET_CPU is only supported with x86_64-unknown-linux-musl" >&2; \
          exit 1; \
        fi; \
        export CC_riscv64gc_unknown_linux_musl=musl-gcc; \
        export CARGO_TARGET_RISCV64GC_UNKNOWN_LINUX_MUSL_LINKER=musl-gcc; \
        export CARGO_TARGET_RISCV64GC_UNKNOWN_LINUX_MUSL_RUSTFLAGS="-Ctarget-feature=+crt-static" \
        ;; \
      *) echo "unsupported OXIBELT_RUST_TARGET=${rust_target}" >&2; exit 1 ;; \
    esac && \
    rustup target add "${rust_target}" && \
    printf '%s' "${rust_target}" >/tmp/oxibelt-rust-target && \
    printf 'export OXIBELT_BUILD_RUST_TARGET=%s\n' "${rust_target}" >/tmp/oxibelt-build-env && \
    env | grep -E '^(CC_|CARGO_TARGET_)' | sed 's/^/export /' >>/tmp/oxibelt-build-env

FROM builder AS controller-builder

RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,target=/repo/target,sharing=locked \
    . /tmp/oxibelt-build-env && \
    cargo build --locked --release -p oxibelt-gateway-controller --bin oxibelt-gateway-controller --target "${OXIBELT_BUILD_RUST_TARGET}" && \
    install -m 0755 "target/${OXIBELT_BUILD_RUST_TARGET}/release/oxibelt-gateway-controller" /tmp/oxibelt-gateway-controller && \
    if readelf -l /tmp/oxibelt-gateway-controller | grep -q 'Requesting program interpreter'; then \
      echo "controller binary must be statically linked" >&2; \
      exit 1; \
    fi

FROM builder AS keysigner-builder

RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,target=/repo/target,sharing=locked \
    . /tmp/oxibelt-build-env && \
    cargo build --locked --release -p oxibelt-keysigner --bin oxibelt-keysigner --target "${OXIBELT_BUILD_RUST_TARGET}" && \
    install -m 0755 "target/${OXIBELT_BUILD_RUST_TARGET}/release/oxibelt-keysigner" /tmp/oxibelt-keysigner && \
    if readelf -l /tmp/oxibelt-keysigner | grep -q 'Requesting program interpreter'; then \
      echo "keysigner binary must be statically linked" >&2; \
      exit 1; \
    fi

FROM builder AS netport-builder

RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,target=/repo/target,sharing=locked \
    . /tmp/oxibelt-build-env && \
    cargo build --locked --release -p oxibelt-netport-switcher --bin oxibelt-netport-switcher --target "${OXIBELT_BUILD_RUST_TARGET}" && \
    install -m 0755 "target/${OXIBELT_BUILD_RUST_TARGET}/release/oxibelt-netport-switcher" /tmp/oxibelt-netport-switcher && \
    if readelf -l /tmp/oxibelt-netport-switcher | grep -q 'Requesting program interpreter'; then \
      echo "netport switcher binary must be statically linked" >&2; \
      exit 1; \
    fi

FROM builder AS tools-builder

RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,target=/repo/target,sharing=locked \
    . /tmp/oxibelt-build-env && \
    cargo build --locked --release -p oxibeltctl --bin oxibeltctl --target "${OXIBELT_BUILD_RUST_TARGET}" && \
    install -m 0755 "target/${OXIBELT_BUILD_RUST_TARGET}/release/oxibeltctl" /tmp/oxibeltctl && \
    if readelf -l /tmp/oxibeltctl | grep -q 'Requesting program interpreter'; then \
      echo "tools binary must be statically linked" >&2; \
      exit 1; \
    fi

FROM builder AS runtime-builder

COPY --from=person-proof-ui /repo/source/assets/person-proof-challenge.html ./source/assets/person-proof-challenge.html
RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,target=/repo/target,sharing=locked \
    . /tmp/oxibelt-build-env && \
    cargo build --locked --release -p oxibelt --bin oxibelt --target "${OXIBELT_BUILD_RUST_TARGET}" && \
    install -m 0755 "target/${OXIBELT_BUILD_RUST_TARGET}/release/oxibelt" /tmp/oxibelt && \
    if readelf -l /tmp/oxibelt | grep -q 'Requesting program interpreter'; then \
      echo "data-plane binary must be statically linked" >&2; \
      exit 1; \
    fi

FROM ${OXIBELT_RUNTIME_IMAGE} AS runtime

RUN apk --no-cache upgrade && \
    apk add --no-cache ca-certificates libgcc libssl3 && \
    rm -rf /var/cache/apk/* && \
    addgroup -S -g 10001 oxibelt && \
    adduser -S -D -H -u 10001 -G oxibelt oxibelt && \
    addgroup -S -g 10002 oxibelt-keysigner && \
    adduser -S -D -H -u 10002 -G oxibelt-keysigner oxibelt-keysigner && \
    mkdir -p /app /etc/oxibelt/config /etc/oxibelt/cert /etc/oxibelt/oxirule \
      /run/oxibelt-keysigner /var/cache/oxibelt && \
    chown oxibelt:oxibelt /var/cache/oxibelt && \
    chown oxibelt-keysigner:oxibelt-keysigner /run/oxibelt-keysigner && \
    chmod 0755 /app /etc/oxibelt /etc/oxibelt/config /etc/oxibelt/cert \
      /etc/oxibelt/oxirule /var/cache/oxibelt && \
    chmod 0770 /run/oxibelt-keysigner

COPY source/config/oxibelt.toml /etc/oxibelt/config/oxibelt.toml
RUN chmod 0644 /etc/oxibelt/config/oxibelt.toml

FROM scratch AS role-metadata

ARG OXIBELT_VERSION
ARG OXIBELT_REVISION
ARG OXIBELT_CREATED
ARG OXIBELT_SOURCE
ARG OXIBELT_REF_NAME

LABEL org.opencontainers.image.source="${OXIBELT_SOURCE}" \
      org.opencontainers.image.url="${OXIBELT_SOURCE}" \
      org.opencontainers.image.version="${OXIBELT_VERSION}" \
      org.opencontainers.image.ref.name="${OXIBELT_REF_NAME}" \
      org.opencontainers.image.revision="${OXIBELT_REVISION}" \
      org.opencontainers.image.created="${OXIBELT_CREATED}" \
      org.opencontainers.image.licenses="Apache-2.0"

COPY --from=runtime /etc/passwd /etc/group /etc/
COPY --from=runtime /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=runtime /tmp /tmp
WORKDIR /app

FROM role-metadata AS dataplane

LABEL org.opencontainers.image.title="OxiBelt data plane" \
      org.opencontainers.image.description="Minimal OxiBelt public data-plane runtime" \
      io.oxibelt.image.role="dataplane"

COPY --from=runtime /etc/oxibelt /etc/oxibelt
COPY --from=runtime /var/cache/oxibelt /var/cache/oxibelt
COPY --from=runtime-builder /tmp/oxibelt /usr/local/bin/oxibelt

USER 10001:10001
EXPOSE 8443/tcp
EXPOSE 8443/udp
STOPSIGNAL SIGINT
ENTRYPOINT ["/usr/local/bin/oxibelt", "--config", "/etc/oxibelt/config/oxibelt.toml"]

FROM role-metadata AS controller

LABEL org.opencontainers.image.title="OxiBelt Gateway Controller" \
      org.opencontainers.image.description="OxiBelt Kubernetes Gateway API controller" \
      io.oxibelt.image.role="controller"

COPY --from=controller-builder /tmp/oxibelt-gateway-controller /usr/local/bin/oxibelt-gateway-controller

USER 10001:10001
STOPSIGNAL SIGINT
ENTRYPOINT ["/usr/local/bin/oxibelt-gateway-controller"]

FROM role-metadata AS tools

LABEL org.opencontainers.image.title="OxiBelt tools" \
      org.opencontainers.image.description="OxiBelt offline diagnostics and operations CLI" \
      io.oxibelt.image.role="tools"

COPY --from=tools-builder /tmp/oxibeltctl /usr/local/bin/oxibeltctl

USER 10001:10001
ENTRYPOINT ["/usr/local/bin/oxibeltctl"]

FROM role-metadata AS keysigner

LABEL org.opencontainers.image.title="OxiBelt keysigner" \
      org.opencontainers.image.description="Isolated OxiBelt private-key signing service" \
      io.oxibelt.image.role="keysigner"

COPY --from=runtime /etc/oxibelt/cert /etc/oxibelt/cert
COPY --from=runtime /run/oxibelt-keysigner /run/oxibelt-keysigner
COPY --from=keysigner-builder /tmp/oxibelt-keysigner /usr/local/bin/oxibelt-keysigner

USER 10002:10002
STOPSIGNAL SIGINT
ENTRYPOINT ["/usr/local/bin/oxibelt-keysigner"]

# Keep this stage last so a Docker build without --target remains the
# compatibility image used by existing standalone deployments and harnesses.
FROM runtime AS standalone

ARG OXIBELT_VERSION
ARG OXIBELT_REVISION
ARG OXIBELT_CREATED
ARG OXIBELT_SOURCE
ARG OXIBELT_REF_NAME

LABEL org.opencontainers.image.title="OxiBelt" \
      org.opencontainers.image.description="Rust reverse proxy with integrated Admin and Person Proof runtimes" \
      org.opencontainers.image.source="${OXIBELT_SOURCE}" \
      org.opencontainers.image.url="${OXIBELT_SOURCE}" \
      org.opencontainers.image.version="${OXIBELT_VERSION}" \
      org.opencontainers.image.ref.name="${OXIBELT_REF_NAME}" \
      org.opencontainers.image.revision="${OXIBELT_REVISION}" \
      org.opencontainers.image.created="${OXIBELT_CREATED}" \
      org.opencontainers.image.licenses="Apache-2.0" \
      io.oxibelt.image.role="standalone"

COPY --from=runtime-builder /tmp/oxibelt /usr/local/bin/oxibelt
COPY --from=keysigner-builder /tmp/oxibelt-keysigner /usr/local/bin/oxibelt-keysigner
COPY --from=netport-builder /tmp/oxibelt-netport-switcher /usr/local/bin/oxibelt-netport-switcher
COPY --from=tools-builder /tmp/oxibeltctl /usr/local/bin/oxibeltctl

WORKDIR /app
USER 10001:10001
EXPOSE 8443/tcp
EXPOSE 8443/udp
STOPSIGNAL SIGINT
ENTRYPOINT ["/usr/local/bin/oxibelt", "--config", "/etc/oxibelt/config/oxibelt.toml"]
