FROM rust:1.95.0-alpine AS builder

RUN apk add --no-cache build-base musl-dev perl

WORKDIR /repo
COPY Cargo.toml Cargo.lock ./
COPY source ./source
RUN cargo build --locked --release -p oxibelt

FROM alpine:3.21

RUN apk add --no-cache ca-certificates libgcc && \
    addgroup -S oxibelt && \
    adduser -S -D -H -u 10001 -G oxibelt oxibelt && \
    mkdir -p /etc/oxibelt/tls

WORKDIR /app
COPY --from=builder /repo/target/release/oxibelt /usr/local/bin/oxibelt
COPY source/config/oxibelt.toml /etc/oxibelt/oxibelt.toml

USER 10001:10001
EXPOSE 8443/tcp

ENTRYPOINT ["/usr/local/bin/oxibelt", "--config", "/etc/oxibelt/oxibelt.toml"]
