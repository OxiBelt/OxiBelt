ARG RUST_BUILDER_IMAGE=rust:1.95.0-alpine3.23
FROM ${RUST_BUILDER_IMAGE} AS builder

ARG OXIBELT_RUST_TARGET=

RUN if command -v apk >/dev/null 2>&1; then \
      apk add --no-cache build-base clang clang-dev cmake musl-dev ninja perl; \
    else \
      apt-get update && \
      apt-get install -y --no-install-recommends \
        build-essential \
        clang \
        cmake \
        libclang-dev \
        musl-tools \
        ninja-build \
        perl \
        pkg-config && \
      rm -rf /var/lib/apt/lists/*; \
    fi

WORKDIR /repo
COPY Cargo.toml Cargo.lock ./
COPY source ./source
RUN if [ -n "${OXIBELT_RUST_TARGET}" ]; then \
      rustup target add "${OXIBELT_RUST_TARGET}" && \
      if [ "${OXIBELT_RUST_TARGET}" = "riscv64gc-unknown-linux-musl" ]; then \
        export CC_riscv64gc_unknown_linux_musl=musl-gcc; \
        export CARGO_TARGET_RISCV64GC_UNKNOWN_LINUX_MUSL_LINKER=musl-gcc; \
        libgcc_s_path="$(find /lib /usr/lib -name libgcc_s.so.1 -print -quit)"; \
        if [ -z "${libgcc_s_path}" ]; then \
          echo "libgcc_s.so.1 is required for riscv64 musl unwind support but was not found." >&2; \
          exit 1; \
        fi; \
        export LIBRARY_PATH="$(dirname "${libgcc_s_path}")${LIBRARY_PATH:+:${LIBRARY_PATH}}"; \
      fi && \
      cargo build --locked --release -p oxibelt --target "${OXIBELT_RUST_TARGET}" && \
      cp "target/${OXIBELT_RUST_TARGET}/release/oxibelt" /tmp/oxibelt; \
    else \
      cargo build --locked --release -p oxibelt && \
      cp target/release/oxibelt /tmp/oxibelt; \
    fi

FROM alpine:3.23

RUN apk add --no-cache ca-certificates libgcc && \
    addgroup -S oxibelt && \
    adduser -S -D -H -u 10001 -G oxibelt oxibelt && \
    mkdir -p /etc/oxibelt/config /etc/oxibelt/cert /etc/oxibelt/oxirule

WORKDIR /app
COPY --from=builder /tmp/oxibelt /usr/local/bin/oxibelt
COPY source/config/oxibelt.toml /etc/oxibelt/config/oxibelt.toml

USER 10001:10001
EXPOSE 8443/tcp

ENTRYPOINT ["/usr/local/bin/oxibelt", "--config", "/etc/oxibelt/config/oxibelt.toml"]
