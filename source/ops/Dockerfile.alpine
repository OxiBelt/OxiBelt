ARG RUST_BUILDER_IMAGE=rust:1.98.0-trixie@sha256:271849e998ffce5776454bbf98c5dc21baafc854ff8e566197908d3aca9a81e8
ARG OXIBELT_NODE_IMAGE=node:24-alpine3.24@sha256:e67514e5d0f6c46656005e1b693b2ec9d52e80b641307de684d4a015ba7a4eaf
ARG OXIBELT_RUNTIME_IMAGE=alpine:3.24@sha256:28bd5fe8b56d1bd048e5babf5b10710ebe0bae67db86916198a6eec434943f8b
ARG OXIBELT_BUILD_VERSION=0.0.0-dev.archive
ARG OXIBELT_BUILD_REVISION=unknown
ARG OXIBELT_BUILD_REF=unknown
ARG OXIBELT_BUILD_DIRTY=unknown
ARG OXIBELT_BUILD_KIND=source_archive
ARG OXIBELT_CREATED=1970-01-01T00:00:00Z
ARG OXIBELT_SOURCE=https://github.com/OxiBelt/OxiBelt
ARG OXIBELT_REF_NAME=0.0.0-dev.archive
ARG OXIBELT_RUST_BUILDER_STAGE=builder-native
ARG OXIBELT_RISCV64_TOOLCHAIN_PLATFORM=linux/amd64

FROM --platform=$BUILDPLATFORM ${OXIBELT_NODE_IMAGE} AS person-proof-ui

WORKDIR /repo
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.json ./
COPY devops/package.json ./devops/package.json
COPY ui/person-proof/package.json ./ui/person-proof/package.json
RUN corepack enable && \
    corepack install && \
    pnpm install --frozen-lockfile --ignore-scripts --filter @oxibelt/person-proof-ui...
COPY ui/person-proof ./ui/person-proof
RUN --network=none pnpm --filter @oxibelt/person-proof-ui build

FROM --platform=$BUILDPLATFORM ${RUST_BUILDER_IMAGE} AS builder-base

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      build-essential \
      clang \
      cmake \
      libclang-dev \
      musl-tools \
      ninja-build \
      perl \
      pkg-config && \
    rm -rf /var/lib/apt/lists/*

FROM builder-base AS builder-native

# cross-rs source revision: 8c1a8aa4b661711f4b7b6ac07c2e8929ce2f7d27
# Copy only the compiler/sysroot. In particular, do not inherit the cross-rs
# emulator helpers or its Cargo runner environment.
FROM --platform=${OXIBELT_RISCV64_TOOLCHAIN_PLATFORM} ghcr.io/cross-rs/riscv64gc-unknown-linux-musl@sha256:6123336467138e0bdc18fc7032032bd5772036ea5f48e91da49895b266fc3298 AS riscv64-cross-toolchain

FROM builder-base AS builder-riscv64

ARG BUILDARCH

COPY --from=riscv64-cross-toolchain /x-tools /x-tools
COPY source/ops/riscv64-musl-toolchain.cmake /opt/oxibelt/riscv64-musl-toolchain.cmake

ENV PATH="/x-tools/riscv64-unknown-linux-musl/bin:${PATH}" \
    AR_riscv64gc_unknown_linux_musl="riscv64-unknown-linux-musl-ar" \
    CC_riscv64gc_unknown_linux_musl="riscv64-unknown-linux-musl-gcc" \
    CXX_riscv64gc_unknown_linux_musl="riscv64-unknown-linux-musl-g++" \
    CARGO_TARGET_RISCV64GC_UNKNOWN_LINUX_MUSL_LINKER="riscv64-unknown-linux-musl-gcc" \
    CMAKE_TOOLCHAIN_FILE_riscv64gc_unknown_linux_musl="/opt/oxibelt/riscv64-musl-toolchain.cmake" \
    BINDGEN_EXTRA_CLANG_ARGS_riscv64gc_unknown_linux_musl="--sysroot=/x-tools/riscv64-unknown-linux-musl/riscv64-unknown-linux-musl/sysroot/"

RUN if [ "${BUILDARCH}" != "amd64" ]; then \
      echo "the pinned RISC-V cross compiler requires BUILDARCH=amd64" >&2; \
      exit 1; \
    fi && \
    compiler=/x-tools/riscv64-unknown-linux-musl/bin/riscv64-unknown-linux-musl-gcc && \
    linker=/x-tools/riscv64-unknown-linux-musl/bin/riscv64-unknown-linux-musl-ld && \
    test "$("${compiler}" -dumpfullversion)" = "14.3.0" && \
    test "$("${compiler}" -dumpmachine)" = "riscv64-unknown-linux-musl" && \
    test "$("${linker}" --version | sed -n '1p')" = "GNU ld (crosstool-NG UNKNOWN) 2.45" && \
    test "$(sha256sum "${compiler}" | awk '{print $1}')" = \
      "8c94c9705057a062899d4a0acaf732bfe9b3fa29483f5ab3dd21594c4aa1a00d"

FROM ${OXIBELT_RUST_BUILDER_STAGE} AS builder

ARG BUILDARCH
ARG TARGETARCH
ARG OXIBELT_RUST_BUILDER_STAGE
ARG OXIBELT_RUST_CACHE_ID=native
ARG OXIBELT_RUST_TARGET=
ARG OXIBELT_AMD64_TARGET_CPU=
ARG OXIBELT_RUST_TARGET_CPU=
ARG OXIBELT_BUILD_VERSION
ARG OXIBELT_BUILD_REVISION
ARG OXIBELT_BUILD_REF
ARG OXIBELT_BUILD_DIRTY
ARG OXIBELT_BUILD_KIND

WORKDIR /repo
COPY Cargo.toml Cargo.lock ./
COPY docs/Embedding.md ./docs/Embedding.md
COPY source ./source
COPY source/apps/oxibelt-dataplane-strict ./source/apps/oxibelt-dataplane-strict
COPY source/apps/oxibelt-gateway-controller ./source/apps/oxibelt-gateway-controller
COPY source/apps/oxibelt-keysigner ./source/apps/oxibelt-keysigner
COPY source/apps/oxibelt-netport-switcher ./source/apps/oxibelt-netport-switcher
COPY source/apps/oxibeltctl ./source/apps/oxibeltctl
COPY source/crates/oxibelt-build-identity ./source/crates/oxibelt-build-identity
COPY source/crates/oxibelt-control-http ./source/crates/oxibelt-control-http
COPY source/crates/oxibelt-control-protocol ./source/crates/oxibelt-control-protocol
COPY source/crates/oxibelt-deployment-diagnostics ./source/crates/oxibelt-deployment-diagnostics
COPY fuzz ./fuzz
COPY tests/unsafe_harness ./tests/unsafe_harness

ENV OXIBELT_BUILD_VERSION=${OXIBELT_BUILD_VERSION} \
    OXIBELT_BUILD_REVISION=${OXIBELT_BUILD_REVISION} \
    OXIBELT_BUILD_REF=${OXIBELT_BUILD_REF} \
    OXIBELT_BUILD_DIRTY=${OXIBELT_BUILD_DIRTY} \
    OXIBELT_BUILD_KIND=${OXIBELT_BUILD_KIND}

RUN rust_target="${OXIBELT_RUST_TARGET}" && \
    amd64_target_cpu="${OXIBELT_AMD64_TARGET_CPU}" && \
    if [ -n "${OXIBELT_RUST_TARGET_CPU}" ]; then \
      if [ -n "${amd64_target_cpu}" ] && [ "${amd64_target_cpu}" != "${OXIBELT_RUST_TARGET_CPU}" ]; then \
        echo "OXIBELT_AMD64_TARGET_CPU conflicts with legacy OXIBELT_RUST_TARGET_CPU" >&2; \
        exit 1; \
      fi; \
      amd64_target_cpu="${OXIBELT_RUST_TARGET_CPU}"; \
    fi && \
    export AWS_LC_SYS_USE_SYSTEM=0 && \
    if [ -z "${rust_target}" ]; then \
      case "${TARGETARCH}" in \
        amd64) rust_target=x86_64-unknown-linux-musl ;; \
        arm64) rust_target=aarch64-unknown-linux-musl ;; \
        riscv64) rust_target=riscv64gc-unknown-linux-musl ;; \
        *) echo "unsupported TARGETARCH=${TARGETARCH}" >&2; exit 1 ;; \
      esac; \
    fi && \
    case "${rust_target}" in \
      x86_64-unknown-linux-musl) \
        if [ "${BUILDARCH}" != "amd64" ] || [ "${OXIBELT_RUST_BUILDER_STAGE}" != "builder-native" ]; then \
          echo "x86_64 musl builds require the native AMD64 builder" >&2; \
          exit 1; \
        fi; \
        case "${amd64_target_cpu}" in \
          ""|x86-64-v2|x86-64-v3|x86-64-v4) ;; \
          *) echo "unsupported OXIBELT_AMD64_TARGET_CPU=${amd64_target_cpu}" >&2; exit 1 ;; \
        esac; \
        export CC_x86_64_unknown_linux_musl=musl-gcc; \
        export CARGO_TARGET_X86_64_UNKNOWN_LINUX_MUSL_LINKER=musl-gcc; \
        if [ -n "${amd64_target_cpu}" ]; then \
          export CARGO_TARGET_X86_64_UNKNOWN_LINUX_MUSL_RUSTFLAGS="-Ctarget-cpu=${amd64_target_cpu}"; \
          export CFLAGS_x86_64_unknown_linux_musl="-march=${amd64_target_cpu}"; \
          export CXXFLAGS_x86_64_unknown_linux_musl="-march=${amd64_target_cpu}"; \
        fi \
        ;; \
      aarch64-unknown-linux-musl) \
        if [ "${BUILDARCH}" != "arm64" ] || [ "${OXIBELT_RUST_BUILDER_STAGE}" != "builder-native" ]; then \
          echo "AArch64 musl builds require the native ARM64 builder" >&2; \
          exit 1; \
        fi; \
        if [ -n "${amd64_target_cpu}" ]; then \
          echo "OXIBELT_AMD64_TARGET_CPU is only supported with x86_64-unknown-linux-musl" >&2; \
          exit 1; \
        fi; \
        export CC_aarch64_unknown_linux_musl=musl-gcc; \
        export CARGO_TARGET_AARCH64_UNKNOWN_LINUX_MUSL_LINKER=musl-gcc \
        ;; \
      riscv64gc-unknown-linux-musl) \
        if [ "${BUILDARCH}" != "amd64" ] || [ "${OXIBELT_RUST_BUILDER_STAGE}" != "builder-riscv64" ]; then \
          echo "RISC-V musl builds require the cross-rs AMD64 builder" >&2; \
          exit 1; \
        fi; \
        if [ -n "${amd64_target_cpu}" ]; then \
          echo "OXIBELT_AMD64_TARGET_CPU is only supported with x86_64-unknown-linux-musl" >&2; \
          exit 1; \
        fi; \
        export CARGO_TARGET_RISCV64GC_UNKNOWN_LINUX_MUSL_RUSTFLAGS="-Ctarget-feature=+crt-static" \
        ;; \
      *) echo "unsupported OXIBELT_RUST_TARGET=${rust_target}" >&2; exit 1 ;; \
    esac && \
    rustup target add "${rust_target}" && \
    printf '%s' "${rust_target}" >/tmp/oxibelt-rust-target && \
    printf 'export OXIBELT_BUILD_RUST_TARGET=%s\n' "${rust_target}" >/tmp/oxibelt-build-env && \
    env | grep -E '^(AR_|CC_|CXX_|CFLAGS_|CXXFLAGS_|CARGO_TARGET_|CMAKE_TOOLCHAIN_FILE_|BINDGEN_EXTRA_CLANG_ARGS_|AWS_LC_)' | \
      sed 's/^/export /' >>/tmp/oxibelt-build-env

FROM builder AS riscv64-musl-check

COPY tests/rust ./tests/rust
COPY tests/fixtures/fuzz-regressions ./tests/fixtures/fuzz-regressions

RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,id=oxibelt-rust-target-${OXIBELT_RUST_CACHE_ID},target=/repo/target,sharing=locked \
    . /tmp/oxibelt-build-env && \
    test "${OXIBELT_BUILD_RUST_TARGET}" = "riscv64gc-unknown-linux-musl" && \
    cargo check --all-targets --locked --target "${OXIBELT_BUILD_RUST_TARGET}"

FROM builder AS controller-builder

RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,id=oxibelt-rust-target-${OXIBELT_RUST_CACHE_ID},target=/repo/target,sharing=locked \
    . /tmp/oxibelt-build-env && \
    cargo build --locked --release -p oxibelt-gateway-controller --bin oxibelt-gateway-controller --target "${OXIBELT_BUILD_RUST_TARGET}" && \
    install -m 0755 "target/${OXIBELT_BUILD_RUST_TARGET}/release/oxibelt-gateway-controller" /tmp/oxibelt-gateway-controller && \
    sh source/ops/verify-static-elf.sh /tmp/oxibelt-gateway-controller \
      "${OXIBELT_BUILD_RUST_TARGET}" "controller binary"

FROM builder AS keysigner-builder

RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,id=oxibelt-rust-target-${OXIBELT_RUST_CACHE_ID},target=/repo/target,sharing=locked \
    . /tmp/oxibelt-build-env && \
    cargo build --locked --release -p oxibelt-keysigner --bin oxibelt-keysigner --target "${OXIBELT_BUILD_RUST_TARGET}" && \
    install -m 0755 "target/${OXIBELT_BUILD_RUST_TARGET}/release/oxibelt-keysigner" /tmp/oxibelt-keysigner && \
    sh source/ops/verify-static-elf.sh /tmp/oxibelt-keysigner \
      "${OXIBELT_BUILD_RUST_TARGET}" "keysigner binary"

FROM builder AS netport-builder

RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,id=oxibelt-rust-target-${OXIBELT_RUST_CACHE_ID},target=/repo/target,sharing=locked \
    . /tmp/oxibelt-build-env && \
    cargo build --locked --release -p oxibelt-netport-switcher --bin oxibelt-netport-switcher --target "${OXIBELT_BUILD_RUST_TARGET}" && \
    install -m 0755 "target/${OXIBELT_BUILD_RUST_TARGET}/release/oxibelt-netport-switcher" /tmp/oxibelt-netport-switcher && \
    sh source/ops/verify-static-elf.sh /tmp/oxibelt-netport-switcher \
      "${OXIBELT_BUILD_RUST_TARGET}" "netport switcher binary"

FROM builder AS tools-builder

RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,id=oxibelt-rust-target-${OXIBELT_RUST_CACHE_ID},target=/repo/target,sharing=locked \
    . /tmp/oxibelt-build-env && \
    cargo build --locked --release -p oxibeltctl --bin oxibeltctl --target "${OXIBELT_BUILD_RUST_TARGET}" && \
    install -m 0755 "target/${OXIBELT_BUILD_RUST_TARGET}/release/oxibeltctl" /tmp/oxibeltctl && \
    sh source/ops/verify-static-elf.sh /tmp/oxibeltctl \
      "${OXIBELT_BUILD_RUST_TARGET}" "tools binary"

FROM builder AS runtime-builder

COPY --from=person-proof-ui /repo/source/assets/person-proof-challenge.html ./source/assets/person-proof-challenge.html
RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,id=oxibelt-rust-target-${OXIBELT_RUST_CACHE_ID},target=/repo/target,sharing=locked \
    . /tmp/oxibelt-build-env && \
    cargo build --locked --release -p oxibelt --bin oxibelt --target "${OXIBELT_BUILD_RUST_TARGET}" && \
    install -m 0755 "target/${OXIBELT_BUILD_RUST_TARGET}/release/oxibelt" /tmp/oxibelt && \
    sh source/ops/verify-static-elf.sh /tmp/oxibelt \
      "${OXIBELT_BUILD_RUST_TARGET}" "data-plane binary"

FROM builder AS strict-dataplane-builder

COPY --from=person-proof-ui /repo/source/assets/person-proof-challenge.html ./source/assets/person-proof-challenge.html
RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,id=oxibelt-rust-target-${OXIBELT_RUST_CACHE_ID},target=/repo/target,sharing=locked \
    . /tmp/oxibelt-build-env && \
    cargo build --locked --release -p oxibelt-dataplane-strict --bin oxibelt-dataplane-strict \
      --no-default-features --target "${OXIBELT_BUILD_RUST_TARGET}" && \
    install -m 0755 "target/${OXIBELT_BUILD_RUST_TARGET}/release/oxibelt-dataplane-strict" \
      /tmp/oxibelt-dataplane-strict && \
    sh source/ops/verify-static-elf.sh /tmp/oxibelt-dataplane-strict \
      "${OXIBELT_BUILD_RUST_TARGET}" "strict data-plane binary" && \
    printf '%s\n' 'oxibelt:x:10001:10001:OxiBelt strict data plane:/nonexistent:/sbin/nologin' \
      >/tmp/oxibelt-strict-passwd && \
    printf '%s\n' 'oxibelt:x:10001:' >/tmp/oxibelt-strict-group && \
    chmod 0644 /tmp/oxibelt-strict-passwd /tmp/oxibelt-strict-group

FROM ${OXIBELT_RUNTIME_IMAGE} AS runtime-seed

# Assemble the target Alpine filesystem as data on the native build platform.
# The target seed is never executed, so this path needs no binary-format handler.
FROM --platform=$BUILDPLATFORM ${OXIBELT_RUNTIME_IMAGE} AS runtime-preparer

ARG TARGETARCH

COPY --from=runtime-seed / /opt/oxibelt-rootfs
COPY source/config/oxibelt.toml /tmp/oxibelt.toml
COPY source/ops/prepare-alpine-rootfs.sh /tmp/prepare-alpine-rootfs.sh
RUN sh /tmp/prepare-alpine-rootfs.sh \
      /opt/oxibelt-rootfs "${TARGETARCH}" /tmp/oxibelt.toml

FROM scratch AS runtime

COPY --from=runtime-preparer /opt/oxibelt-rootfs/ /

FROM runtime AS strict-runtime

COPY --from=runtime-preparer /opt/oxibelt-strict.toml /etc/oxibelt/config/oxibelt.toml

FROM scratch AS role-metadata

ARG OXIBELT_BUILD_VERSION
ARG OXIBELT_BUILD_REVISION
ARG OXIBELT_BUILD_REF
ARG OXIBELT_BUILD_DIRTY
ARG OXIBELT_BUILD_KIND
ARG OXIBELT_CREATED
ARG OXIBELT_SOURCE
ARG OXIBELT_REF_NAME

LABEL org.opencontainers.image.source="${OXIBELT_SOURCE}" \
      org.opencontainers.image.url="${OXIBELT_SOURCE}" \
      org.opencontainers.image.version="${OXIBELT_BUILD_VERSION}" \
      org.opencontainers.image.ref.name="${OXIBELT_REF_NAME}" \
      org.opencontainers.image.revision="${OXIBELT_BUILD_REVISION}" \
      org.opencontainers.image.created="${OXIBELT_CREATED}" \
      org.opencontainers.image.licenses="Apache-2.0" \
      io.oxibelt.build.source-ref="${OXIBELT_BUILD_REF}" \
      io.oxibelt.build.dirty="${OXIBELT_BUILD_DIRTY}" \
      io.oxibelt.build.kind="${OXIBELT_BUILD_KIND}"

COPY --from=runtime /etc/passwd /etc/group /etc/
COPY --from=runtime /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=runtime /tmp /tmp
WORKDIR /app

FROM role-metadata AS dataplane

LABEL org.opencontainers.image.title="OxiBelt data plane" \
      org.opencontainers.image.description="Minimal OxiBelt public data-plane runtime" \
      io.oxibelt.image.role="dataplane"

COPY --from=runtime /etc/oxibelt /etc/oxibelt
COPY --from=runtime /var/cache/oxibelt /var/cache/oxibelt
COPY --from=runtime-builder /tmp/oxibelt /usr/local/bin/oxibelt

USER 10001:10001
EXPOSE 8443/tcp
EXPOSE 8443/udp
STOPSIGNAL SIGINT
ENTRYPOINT ["/usr/local/bin/oxibelt", "--config", "/etc/oxibelt/config/oxibelt.toml"]

FROM scratch AS dataplane-strict

ARG OXIBELT_BUILD_VERSION
ARG OXIBELT_BUILD_REVISION
ARG OXIBELT_BUILD_REF
ARG OXIBELT_BUILD_DIRTY
ARG OXIBELT_BUILD_KIND
ARG OXIBELT_CREATED
ARG OXIBELT_SOURCE
ARG OXIBELT_REF_NAME

LABEL org.opencontainers.image.title="OxiBelt strict data plane" \
      org.opencontainers.image.description="Compile-time Admin-free OxiBelt public data-plane runtime" \
      org.opencontainers.image.source="${OXIBELT_SOURCE}" \
      org.opencontainers.image.url="${OXIBELT_SOURCE}" \
      org.opencontainers.image.version="${OXIBELT_BUILD_VERSION}" \
      org.opencontainers.image.ref.name="${OXIBELT_REF_NAME}" \
      org.opencontainers.image.revision="${OXIBELT_BUILD_REVISION}" \
      org.opencontainers.image.created="${OXIBELT_CREATED}" \
      org.opencontainers.image.licenses="Apache-2.0" \
      io.oxibelt.build.source-ref="${OXIBELT_BUILD_REF}" \
      io.oxibelt.build.dirty="${OXIBELT_BUILD_DIRTY}" \
      io.oxibelt.build.kind="${OXIBELT_BUILD_KIND}" \
      io.oxibelt.image.role="dataplane-strict"

COPY --from=strict-dataplane-builder /tmp/oxibelt-strict-passwd /etc/passwd
COPY --from=strict-dataplane-builder /tmp/oxibelt-strict-group /etc/group
COPY --from=runtime /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=strict-runtime /etc/oxibelt /etc/oxibelt
COPY --from=strict-runtime /app /app
COPY --from=strict-dataplane-builder /tmp/oxibelt-dataplane-strict /usr/local/bin/oxibelt-dataplane-strict

WORKDIR /app
USER 10001:10001
EXPOSE 8443/tcp
EXPOSE 8443/udp
STOPSIGNAL SIGINT
ENTRYPOINT ["/usr/local/bin/oxibelt-dataplane-strict", "--config", "/etc/oxibelt/config/oxibelt.toml"]

FROM role-metadata AS controller

LABEL org.opencontainers.image.title="OxiBelt Gateway Controller" \
      org.opencontainers.image.description="OxiBelt Kubernetes Gateway API controller" \
      io.oxibelt.image.role="controller"

COPY --from=controller-builder /tmp/oxibelt-gateway-controller /usr/local/bin/oxibelt-gateway-controller

USER 10001:10001
STOPSIGNAL SIGINT
ENTRYPOINT ["/usr/local/bin/oxibelt-gateway-controller"]

FROM role-metadata AS tools

LABEL org.opencontainers.image.title="OxiBelt tools" \
      org.opencontainers.image.description="OxiBelt offline diagnostics and operations CLI" \
      io.oxibelt.image.role="tools"

COPY --from=tools-builder /tmp/oxibeltctl /usr/local/bin/oxibeltctl

USER 10001:10001
ENTRYPOINT ["/usr/local/bin/oxibeltctl"]

FROM role-metadata AS keysigner

LABEL org.opencontainers.image.title="OxiBelt keysigner" \
      org.opencontainers.image.description="Isolated OxiBelt private-key signing service" \
      io.oxibelt.image.role="keysigner"

COPY --from=runtime /etc/oxibelt/cert /etc/oxibelt/cert
COPY --from=runtime --chown=10002:10002 --chmod=0770 /run/oxibelt-keysigner /run/oxibelt-keysigner
COPY --from=keysigner-builder /tmp/oxibelt-keysigner /usr/local/bin/oxibelt-keysigner

USER 10002:10002
STOPSIGNAL SIGINT
ENTRYPOINT ["/usr/local/bin/oxibelt-keysigner"]

# Keep this stage last so a Docker build without --target remains the
# compatibility image used by existing standalone deployments and harnesses.
FROM runtime AS standalone

ARG OXIBELT_BUILD_VERSION
ARG OXIBELT_BUILD_REVISION
ARG OXIBELT_BUILD_REF
ARG OXIBELT_BUILD_DIRTY
ARG OXIBELT_BUILD_KIND
ARG OXIBELT_CREATED
ARG OXIBELT_SOURCE
ARG OXIBELT_REF_NAME

LABEL org.opencontainers.image.title="OxiBelt" \
      org.opencontainers.image.description="Rust reverse proxy with integrated Admin and Person Proof runtimes" \
      org.opencontainers.image.source="${OXIBELT_SOURCE}" \
      org.opencontainers.image.url="${OXIBELT_SOURCE}" \
      org.opencontainers.image.version="${OXIBELT_BUILD_VERSION}" \
      org.opencontainers.image.ref.name="${OXIBELT_REF_NAME}" \
      org.opencontainers.image.revision="${OXIBELT_BUILD_REVISION}" \
      org.opencontainers.image.created="${OXIBELT_CREATED}" \
      org.opencontainers.image.licenses="Apache-2.0" \
      io.oxibelt.build.source-ref="${OXIBELT_BUILD_REF}" \
      io.oxibelt.build.dirty="${OXIBELT_BUILD_DIRTY}" \
      io.oxibelt.build.kind="${OXIBELT_BUILD_KIND}" \
      io.oxibelt.image.role="standalone"

COPY --from=runtime-builder /tmp/oxibelt /usr/local/bin/oxibelt
COPY --from=keysigner-builder /tmp/oxibelt-keysigner /usr/local/bin/oxibelt-keysigner
COPY --from=netport-builder /tmp/oxibelt-netport-switcher /usr/local/bin/oxibelt-netport-switcher
COPY --from=tools-builder /tmp/oxibeltctl /usr/local/bin/oxibeltctl

WORKDIR /app
USER 10001:10001
EXPOSE 8443/tcp
EXPOSE 8443/udp
STOPSIGNAL SIGINT
ENTRYPOINT ["/usr/local/bin/oxibelt", "--config", "/etc/oxibelt/config/oxibelt.toml"]
