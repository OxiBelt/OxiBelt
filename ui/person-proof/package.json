{
  "name": "@oxibelt/person-proof-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json && tsx source/build.ts",
    "check:openapi": "tsx --tsconfig tsconfig.json ../../tests/scripts/check-person-proof-ui-openapi.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint source/**/*.ts"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "tsx": "4.23.0",
    "typescript": "6.0.3"
  },
  "overrides": {
    "tsx": {
      "esbuild": "0.28.1"
    },
    "@types/node": {
      "undici-types": "7.18.0"
    }
  }
}
