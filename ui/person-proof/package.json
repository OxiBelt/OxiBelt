{
  "name": "@oxibelt/person-proof-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json && tsx source/build.ts",
    "check:openapi": "tsx --tsconfig tsconfig.json ../../tests/scripts/check-person-proof-ui-openapi.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint source/**/*.ts"
  },
  "devDependencies": {
    "@types/node": "25.9.1",
    "tsx": "4.22.4",
    "typescript": "6.0.3"
  },
  "overrides": {
    "get-tsconfig": {
      "resolve-pkg-maps": "1.0.0"
    },
    "tsx": {
      "esbuild": "0.27.7",
      "get-tsconfig": "4.14.0"
    },
    "@types/node": {
      "undici-types": "7.16.0"
    }
  }
}
