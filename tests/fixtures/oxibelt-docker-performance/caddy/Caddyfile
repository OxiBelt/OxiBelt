{
  admin off
  auto_https off

  servers :8443 {
    protocols h1 h2 h3
  }
}

:8443 {
  tls /etc/caddy/fullchain.pem /etc/caddy/privkey.pem
  handle_path /static/* {
    root * /srv/static
    file_server
  }
  reverse_proxy perf-upstream:18080
}

:8080 {
  handle_path /static/* {
    root * /srv/static
    file_server
  }
  reverse_proxy perf-upstream:18080
}
