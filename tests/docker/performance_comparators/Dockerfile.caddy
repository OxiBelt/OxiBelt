ARG CADDY_VERSION=2.11.2

FROM caddy:${CADDY_VERSION}-builder-alpine AS builder

ARG CADDY_VERSION
ARG CADDY_TARGET_CPU=x86-64-v2

RUN case "${CADDY_TARGET_CPU}" in \
      x86-64-v2) export GOAMD64=v2 ;; \
      x86-64-v3) export GOAMD64=v3 ;; \
      *) echo "unsupported CADDY_TARGET_CPU=${CADDY_TARGET_CPU}" >&2; exit 1 ;; \
    esac && \
    GOOS=linux GOARCH=amd64 xcaddy build "v${CADDY_VERSION}" --output /usr/bin/caddy

FROM caddy:${CADDY_VERSION}-alpine AS runtime

ARG CADDY_VERSION
ARG CADDY_TARGET_CPU

COPY --from=builder /usr/bin/caddy /usr/bin/caddy

LABEL org.opencontainers.image.title="OxiBelt performance Caddy comparator" \
      org.opencontainers.image.version="${CADDY_VERSION}" \
      org.opencontainers.image.description="Caddy comparator built with AMD64 target CPU tuning" \
      org.oxibelt.performance.comparator="caddy" \
      org.oxibelt.performance.amd64_target_cpu="${CADDY_TARGET_CPU}"
